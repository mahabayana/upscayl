{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:upshift64:project-config:1",
  "title": "Upshift64 reusable port configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "repositories",
    "target",
    "build",
    "artifacts",
    "validation",
    "privacy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application"],
      "properties": {
        "application": {
          "$ref": "#/$defs/repository"
        },
        "backend": {
          "$ref": "#/$defs/repository"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "compatibilityArchitectures"],
      "properties": {
        "os": {
          "const": "windows"
        },
        "architecture": {
          "enum": ["arm64", "arm64ec"]
        },
        "compatibilityArchitectures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["arm64", "arm64ec", "x64", "x86"]
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "configuration"],
      "properties": {
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceRoot", "nativeFilePolicy"],
      "properties": {
        "evidenceRoot": {
          "type": "string",
          "minLength": 1
        },
        "stagingRoot": {
          "type": "string"
        },
        "nativeFilePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredArchitecture", "exceptions"],
          "properties": {
            "requiredArchitecture": {
              "enum": ["arm64", "arm64ec"]
            },
            "exceptions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "architectures", "reason"],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "architectures": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": ["arm64", "arm64ec", "x64", "x86"]
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "offlineRequired"],
      "properties": {
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "files"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            }
          }
        },
        "providerPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api", "allowedIdentifiers", "deniedIdentifiers"],
          "properties": {
            "api": {
              "type": "string",
              "minLength": 1
            },
            "allowedIdentifiers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "deniedIdentifiers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "offlineRequired": {
          "type": "boolean"
        },
        "expectedOutput": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {
              "type": "string"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicationMode", "requireImageReview"],
      "properties": {
        "publicationMode": {
          "enum": ["private", "public"]
        },
        "requireImageReview": {
          "type": "boolean"
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["required"],
        "properties": {
          "required": {
            "type": "boolean"
          },
          "versionOrRevision": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "branch", "revision"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "submodules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "revision"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$"
              }
            }
          }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}
